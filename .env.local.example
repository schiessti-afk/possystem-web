# URL of the FastAPI ingestion/analytics backend (the Docker stack).
# Must be reachable from this machine, not from the browser: all backend
# calls happen server-side inside React Server Components.
BACKEND_URL=http://127.0.0.1:8000

# Must equal DASHBOARD_API_KEY configured on the backend.
# Stays on the server — the browser never receives this key.
DASHBOARD_API_KEY=owner_secure_access_key
