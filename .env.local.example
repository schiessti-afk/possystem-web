# URL of the FastAPI ingestion/analytics backend (the Docker stack).
# Must be reachable from this machine, not from the browser: all backend
# calls happen server-side inside React Server Components.
BACKEND_URL=http://127.0.0.1:8000

# The UI needs no API key: it signs in at /login and authenticates with the
# admin's session token. Create the account first with
#   docker compose exec backend python scripts/onboard.py
