# --- Database ---
# asyncpg DSN. Note: asyncpg wants the postgresql:// scheme.
DATABASE_URL=postgresql://pos_user:CHANGE_ME@localhost:5432/pos_remote_db

# --- Auth ---
# Must equal POS_API_TOKEN on the register (app/config.py of possystem).
# The sync worker sends: Authorization: Bearer <API_BEARER_TOKEN>
API_BEARER_TOKEN=generate_a_long_random_hex_string

# Owner dashboard access, sent as X-API-Key header on /api/v1/dashboard/*
DASHBOARD_API_KEY=generate_another_long_random_hex_string

# Comma-separated browser origins allowed to call the dashboard API.
# Use your dashboard domain in production; * only for local development.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

PORT=8000
