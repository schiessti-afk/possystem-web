# Copy to .env.prod and replace every value. .env.prod is gitignored.
# Generate secrets with:  openssl rand -hex 32

# --- public hostname -------------------------------------------------
# Free DuckDNS name, without the scheme. Must resolve to this VPS before
# the first start, or Caddy cannot obtain a certificate.
SITE_DOMAIN=yourname.duckdns.org
# Where Let's Encrypt sends certificate expiry warnings.
ACME_EMAIL=you@example.com

# The subdomain only (for "yourname.duckdns.org" this is "yourname"),
# plus the token from https://www.duckdns.org after you sign in.
DUCKDNS_SUBDOMAIN=yourname
DUCKDNS_TOKEN=
TZ=Europe/Zurich

# --- database --------------------------------------------------------
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=
POSTGRES_DB=pos_remote_db

# --- application secrets ---------------------------------------------
# Presented by each register when it pushes events to /api/v1/sync.
# Must be mirrored in the POS configuration.
API_BEARER_TOKEN=
# Used server-side by the dashboard UI to read the analytics endpoints.
DASHBOARD_API_KEY=
